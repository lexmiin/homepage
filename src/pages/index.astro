---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { projects } from '@/lib/projects'
import { Image } from 'astro:assets'

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2)

const homePreviewClass =
  'group -mx-3 block rounded-lg px-3 py-1 focus-visible:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link pointer-fine:hover:bg-accent pointer-fine:active:bg-accent motion-safe:pointer-fine:transition-[background-color_150ms_ease,transform_120ms_cubic-bezier(0.23,1,0.32,1)] motion-safe:pointer-fine:active:scale-[0.99]'
---

<BaseLayout description="Software Engineer based in Kyiv, Ukraine.">
  <div class="mb-10 flex items-center gap-4">
    <div class="relative size-16 shrink-0 overflow-hidden rounded-full">
      <Image
        src="/profile.png"
        alt="Profile"
        width="100"
        height="64"
        class="size-full object-cover"
        loading="eager"
      />
    </div>
    <div>
      <h1 class="font-semibold">Alexey Miin</h1><p
        class="text-muted-foreground"
      >
        Software Engineer at Uvaga Communications Agency
      </p>
    </div>
  </div>
  <div class="flex flex-col gap-4">
    <p>Software Engineer based in Kyiv, Ukraine.</p>
  </div>
  <div class="mt-20 mb-15 sm:mt-28">
    <section
      class="mt-20 mb-15 sm:mt-28 [&>h2]:mb-5 [&>h2]:text-base [&>h2]:text-muted-foreground"
    >
      <h2>Projects</h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-5">
        {
          projects.slice(0, 2).map(p => (
            <div>
              <a
                href={p.href}
                target="_blank"
                rel="noreferrer noopener"
                class={homePreviewClass}
              >
                <span class="flex min-h-9 items-center leading-6 font-medium">
                  {p.name}
                  <span
                    class="ml-1.5 text-muted-foreground opacity-65 motion-safe:pointer-fine:transition-[opacity_150ms_ease,transform_150ms_cubic-bezier(0.23,1,0.32,1)] motion-safe:pointer-fine:group-hover:translate-x-px motion-safe:pointer-fine:group-hover:-translate-y-px pointer-fine:group-hover:opacity-100"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                  <span class="visually-hidden">Opens in a new tab</span>
                </span>
                <span class="block text-muted-foreground">{p.description}</span>
              </a>
            </div>
          ))
        }
        <div>
          <a href="/projects" class="grid leading-9 font-medium">All projects</a
          >
        </div>
      </div>
    </section>
    <section
      class="mt-20 mb-15 sm:mt-28 [&>h2]:mb-5 [&>h2]:text-base [&>h2]:text-muted-foreground"
    >
      <h2>Writing</h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-5">
        {
          posts.map(p => (
            <div>
              <a href={`/writing/${p.id}`} class={homePreviewClass}>
                <span class="flex min-h-9 items-center leading-6 font-medium">
                  {p.data.title}
                </span>
                <span class="block text-muted-foreground">
                  {p.data.description}
                </span>
              </a>
            </div>
          ))
        }
        <div>
          <a href="/writing" class="grid leading-9 font-medium">All writing</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
